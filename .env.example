# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must never be committed.

# Supabase project URL — Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key — Settings > API > Project API keys > anon/public.
# Anything prefixed NEXT_PUBLIC_ is bundled into client JS and visible to every
# visitor, so this must be the anon key, never the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Settings > API > Project API keys > service_role.
# Server-side only. Bypasses row level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
